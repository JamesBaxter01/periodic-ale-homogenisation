% Equilibrated cell parameters (consolidation_parameter_table.py): the rest values, then the change
% from rest at each state. Needs \usepackage{booktabs}.
\begin{table}
\centering
\caption{Response derivatives of the periodic cell at four states of the FE$^2$ consolidation run of Figure~\ref{fig:consolidation} (viscoelastic skeleton, step load): at rest; $10\,\mathrm{s}$ after loading in the bottom cell (nearly undrained) and in the top cell (draining), sampled at the integration points at $Z=0.054$ and $0.949\,\mathrm m$; and fully drained, when every cell is in the same state. Each state is the axial stretch $F_{33}$ and pore pressure $\overline p$ of that material point; a fresh cell is brought there from rest by five increments of $1000\,\mathrm{s}$ with zero pressure gradient, and the entries are derivatives of the last increment at fixed other inputs: $\kappa_{ii}=-\mu_f\,\partial Q_{0,i}/\partial G_{p,i}$ (referential, in $\mathrm m^2$), $\alpha_{ii}=-\partial\overline P_{ii}/\partial\overline p$, $1/M=\partial m_f/\partial\overline p$ and $C^{\mathrm{dr}}=\partial\overline{\bm P}/\partial\overline{\bm F}$ (drained, at fixed $\overline p$). They are long-step approximations to equilibrium response derivatives, distinct from the inherited step tangents of the transient FE$^2$ solve; setting $\eta_s=\zeta_s=0$, using $3000\,\mathrm s$ increments or adding a final increment at fixed inputs changes every entry by less than $5\times10^{-4}$ (relative). Index 3 is along the column and 1 across it. The first row gives the values at rest, the others the change from rest.}
\label{tab:consolidation_parameters}
